{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "public": true,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ],
  "rewrites": [
    { "source": "/dashboard", "destination": "https://YOUR-APP-HOST.vercel.app/dashboard" },
    { "source": "/dashboard/:path*", "destination": "https://YOUR-APP-HOST.vercel.app/dashboard/:path*" },
    { "source": "/chat", "destination": "https://YOUR-APP-HOST.vercel.app/chat" },
    { "source": "/chat/:path*", "destination": "https://YOUR-APP-HOST.vercel.app/chat/:path*" },
    { "source": "/sign-in", "destination": "https://YOUR-APP-HOST.vercel.app/sign-in" },
    { "source": "/sign-in/:path*", "destination": "https://YOUR-APP-HOST.vercel.app/sign-in/:path*" },
    { "source": "/sign-up", "destination": "https://YOUR-APP-HOST.vercel.app/sign-up" },
    { "source": "/integrations", "destination": "https://YOUR-APP-HOST.vercel.app/integrations" },
    { "source": "/integrations/:path*", "destination": "https://YOUR-APP-HOST.vercel.app/integrations/:path*" },
    { "source": "/docs", "destination": "https://YOUR-APP-HOST.vercel.app/docs" },
    { "source": "/docs/:path*", "destination": "https://YOUR-APP-HOST.vercel.app/docs/:path*" },
    { "source": "/faq", "destination": "https://YOUR-APP-HOST.vercel.app/faq" },
    { "source": "/about", "destination": "https://YOUR-APP-HOST.vercel.app/about" },
    { "source": "/api/:path*", "destination": "https://YOUR-APP-HOST.vercel.app/api/:path*" }
  ]
}
