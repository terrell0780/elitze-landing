{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "public": true,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ],
  "rewrites": [
    { "source": "/console", "destination": "https://YOUR-APP-HOST/console" },
    { "source": "/console/:path*", "destination": "https://YOUR-APP-HOST/console/:path*" },
    { "source": "/chat", "destination": "https://YOUR-APP-HOST/chat" },
    { "source": "/chat/:path*", "destination": "https://YOUR-APP-HOST/chat/:path*" },
    { "source": "/orchestration", "destination": "https://YOUR-APP-HOST/orchestration" },
    { "source": "/orchestration/:path*", "destination": "https://YOUR-APP-HOST/orchestration/:path*" },
    { "source": "/recursive-agents", "destination": "https://YOUR-APP-HOST/recursive-agents" },
    { "source": "/recursive-agents/:path*", "destination": "https://YOUR-APP-HOST/recursive-agents/:path*" },
    { "source": "/login", "destination": "https://YOUR-APP-HOST/login" },
    { "source": "/login/:path*", "destination": "https://YOUR-APP-HOST/login/:path*" },
    { "source": "/docs", "destination": "https://YOUR-APP-HOST/docs" },
    { "source": "/docs/:path*", "destination": "https://YOUR-APP-HOST/docs/:path*" },
    { "source": "/faq", "destination": "https://YOUR-APP-HOST/faq" },
    { "source": "/how-to", "destination": "https://YOUR-APP-HOST/how-to" },
    { "source": "/how-to/:path*", "destination": "https://YOUR-APP-HOST/how-to/:path*" },
    { "source": "/about", "destination": "https://YOUR-APP-HOST/about" },
    { "source": "/contact", "destination": "https://YOUR-APP-HOST/contact" },
    { "source": "/api/:path*", "destination": "https://YOUR-APP-HOST/api/:path*" },
    { "source": "/_next/:path*", "destination": "https://YOUR-APP-HOST/_next/:path*" }
  ]
}
